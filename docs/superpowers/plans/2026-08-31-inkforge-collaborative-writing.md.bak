```python
import json, pytest
from unittest.mock import patch
from modules import ai_writer

def _login(app, monkeypatch):
    # 直接构造已登录用户：patch get_current_user 返回 admin
    import web_app
    monkeypatch.setattr(web_app, "get_current_user", lambda sid: {"id": 1, "role": "admin", "username": "admin"})

def _create(app):
    r = app.post("/api/collaborative/projects", data=json.dumps({"title": "测试"}), content_type="application/json")
    return r.get_json()["project_id"]

def test_list_create_get_state(app, monkeypatch):
    _login(app, monkeypatch)
    assert app.get("/api/collaborative/projects").status_code == 200
    pid = _create(app)
    assert pid > 0
    r = app.get(f"/api/collaborative/{pid}/state")
    assert r.status_code == 200 and r.get_json()["phase"] == "topic"

def test_generate_topics_api(app, monkeypatch):
    _login(app, monkeypatch)
    pid = _create(app)
    with patch("modules.ai_writer.generate_topics", return_value=[{"title":"t","description":"d"}]*2):
        r = app.post(f"/api/collaborative/{pid}/generate-topics",
                     data=json.dumps({"idea": "AI"}), content_type="application/json")
    assert r.status_code == 200
    assert len(r.get_json()["topics"]) == 2

def test_save_article_forces_label(app, monkeypatch):
    _login(app, monkeypatch)
    pid = _create(app)
    body = {"title": "文章", "topic_json": {"idea": "AI"},
            "outline_json": {"sections": [{"id":"s1","title":"x"}]},
            "content_json": {"sections": [{"id":"s1","title":"x","content":"正文","status":"generated"}]}}
    r = app.post(f"/api/collaborative/{pid}/save-article", data=json.dumps(body), content_type="application/json")
    assert r.status_code == 200
    assert "article_id" in r.get_json()

def test_versions_and_rollback(app, monkeypatch):
    _login(app, monkeypatch)
    pid = _create(app)
    rv = app.post(f"/api/collaborative/{pid}/versions", data=json.dumps({"version_name":"v1","content_json":{"n":1},"trigger_type":"manual"}), content_type="application/json")
    assert rv.status_code == 200
    assert rv.get_json()["version_id"] > 0
```


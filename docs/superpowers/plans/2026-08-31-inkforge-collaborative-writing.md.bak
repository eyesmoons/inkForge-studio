import pytest, json
from modules import article_history

def _payload(title="测试文章", with_label=True):
    content = "正文" + ("\n\n本文由 AI 辅助生成，请仔细甄别文章内容。" if with_label else "")
    return {
        "title": title,
        "topic_json": {"idea": "AI"},
        "outline_json": {"sections": [{"id": "s1", "title": "x"}]},
        "content_json": {"sections": [{"id": "s1", "title": "x", "content": content, "status": "generated"}]},
    }

def test_save_article_attaches_label(db):
    aid = article_history.save_article(1, **_payload(with_label=False))
    art = article_history.get_article(aid, 1)
    assert "AI" in art["ai_label"]

def test_save_article_rejects_missing_label(db):
    # content 全文不含标识且 attach_label 也无法补救的极端情况：直接构造 content_json 字符串也无标识
    p = _payload()
    p["content_json"] = {"sections": [{"id": "s1", "title": "x", "content": "完全无标识", "status": "generated"}]}
    # attach_label 会补救，因此这里测的是 validate 在 attach 后仍失败的场景：
    # 为覆盖「阻止保存」分支，直接 patch attach_label 返回无标识内容
    from unittest.mock import patch
    with patch("modules.article_history.ai_labeler.attach_label", return_value="完全无标识"):
        with pytest.raises(ValueError):
            article_history.save_article(1, **p)

def test_list_articles_order(db):
    article_history.save_article(1, **_payload("A"))
    article_history.save_article(1, **_payload("B"))
    arts = article_history.list_articles(1)
    assert len(arts) == 2
    assert arts[0]["created_at"] >= arts[1]["created_at"]

def test_update_and_delete(db):
    aid = article_history.save_article(1, **_payload("原"))
    assert article_history.update_article(aid, 1, title="改") is True
    assert article_history.get_article(aid, 1)["title"] == "改"
    assert article_history.delete_article(aid, 1) is True
    assert article_history.get_article(aid, 1) is None

- [ ] **Step 3: 实现 `modules/article_history.py`**

```python
import json
from typing import Dict, List, Optional
from modules.user_db import get_db
from modules import ai_labeler


def save_article(user_id: int, title: str, topic_json: dict, outline_json: dict, content_json: dict) -> int:
    # 强制附加标识：把 content_json 序列化后 attach_label，再校验
    content_str = json.dumps(content_json, ensure_ascii=False)
    labeled = ai_labeler.attach_label(content_str)
    if not ai_labeler.validate_content(labeled):
        raise ValueError("AI 标识校验失败：保存的文章必须包含 AI 标识")
    content_json = json.loads(labeled)
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            """INSERT INTO article_history
               (user_id, title, topic_json, outline_json, content_json, ai_label)
               VALUES (?, ?, ?, ?, ?, ?)""",
            (user_id, title,
             json.dumps(topic_json, ensure_ascii=False),
             json.dumps(outline_json, ensure_ascii=False),
             json.dumps(content_json, ensure_ascii=False),
             ai_labeler.get_label_text()),
        )
        db.conn.commit()
        return cur.lastrowid


def list_articles(user_id: int) -> List[Dict]:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            "SELECT * FROM article_history WHERE user_id = ? ORDER BY created_at DESC, id DESC",
            (user_id,),
        )
        return [dict(r) for r in cur.fetchall()]


def get_article(article_id: int, user_id: int) -> Optional[Dict]:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute("SELECT * FROM article_history WHERE id = ? AND user_id = ?", (article_id, user_id))
        row = cur.fetchone()
        return dict(row) if row else None


def update_article(article_id: int, user_id: int, **fields) -> bool:
    allowed = {"title", "topic_json", "outline_json", "content_json"}
    sets, vals = [], []
    for k, v in fields.items():
        if k not in allowed:
            continue
        sets.append(f"{k} = ?")
        vals.append(json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else v)
    if not sets:
        return False
    vals.extend([article_id, user_id])
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(f"UPDATE article_history SET {', '.join(sets)} WHERE id = ? AND user_id = ?", vals)
        db.conn.commit()
        return cur.rowcount > 0


def delete_article(article_id: int, user_id: int) -> bool:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute("DELETE FROM article_history WHERE id = ? AND user_id = ?", (article_id, user_id))
        db.conn.commit()
        return cur.rowcount > 0
```


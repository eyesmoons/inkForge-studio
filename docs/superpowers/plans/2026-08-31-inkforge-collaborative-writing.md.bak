## 阶段六：集成测试与验收

### Task 15: 端到端集成测试

**Files:**
- Create: `tests/test_e2e_collaborative.py`

**Interfaces:**
- Consumes: 全部协同创作 API、`version_manager`、`article_history`、`ai_labeler`、`ai_writer`（mock LLM）
- Produces: 覆盖设计文档 §8.4 的 5 个关键测试场景

- [ ] **Step 1: 编写端到端测试**

```python
import json, pytest
from unittest.mock import patch
import web_app

def _auth(app, monkeypatch):
    monkeypatch.setattr(web_app, "get_current_user", lambda sid: {"id": 1, "role": "admin"})

def _new_project(app):
    r = app.post("/api/collaborative/projects", data=json.dumps({"title":"e2e"}), content_type="application/json")
    return r.get_json()["project_id"]

TOPICS = [{"title":"t1","description":"d1"}]
OUTLINE = {"sections":[{"id":"s1","title":"章节","points":["p"],"children":[]}]}
CONTENT = {"sections":[{"id":"s1","title":"章节","content":"正文","status":"generated"}]}

def test_e2e_full_flow(app, monkeypatch):
    _auth(app, monkeypatch)
    pid = _new_project(app)
    with patch("modules.ai_writer.generate_topics", return_value=TOPICS), \
         patch("modules.ai_writer.generate_outline", return_value=OUTLINE), \
         patch("modules.ai_writer.generate_content", return_value=CONTENT):
        app.post(f"/api/collaborative/{pid}/generate-topics", data=json.dumps({"idea":"AI"}), content_type="application/json")
        app.put(f"/api/collaborative/{pid}/topic", data=json.dumps({"topic":TOPICS[0]}), content_type="application/json")
        app.post(f"/api/collaborative/{pid}/generate-outline", data=json.dumps({"topic":"t1"}), content_type="application/json")
        app.put(f"/api/collaborative/{pid}/outline", data=json.dumps({"outline":OUTLINE}), content_type="application/json")
        app.post(f"/api/collaborative/{pid}/generate-content", data=json.dumps({"outline":OUTLINE}), content_type="application/json")
        app.put(f"/api/collaborative/{pid}/content", data=json.dumps({"content":CONTENT}), content_type="application/json")
        r = app.post(f"/api/collaborative/{pid}/save-article", data=json.dumps({"title":"成品"}), content_type="application/json")
    assert r.status_code == 200
    aid = r.get_json()["article_id"]
    # 验证 AI 标识存在
    from modules import article_history
    art = article_history.get_article(aid, 1)
    assert "AI" in art["ai_label"]

def test_e2e_ai_label_blocked(app, monkeypatch):
    _auth(app, monkeypatch)
    pid = _new_project(app)
    from unittest.mock import patch as _p
    with _p("modules.article_history.ai_labeler.attach_label", return_value="无标识正文"):
        r = app.post(f"/api/collaborative/{pid}/save-article",
                     data=json.dumps({"title":"x","topic_json":{},"outline_json":{},"content_json":{}}),
                     content_type="application/json")
    assert r.status_code == 400

def test_e2e_version_rollback(app, monkeypatch):
    _auth(app, monkeypatch)
    pid = _new_project(app)
    r1 = app.post(f"/api/collaborative/{pid}/versions", data=json.dumps({"version_name":"v1","content_json":{"n":1},"trigger_type":"manual"}), content_type="application/json")
    v1 = r1.get_json()["version_id"]
    app.post(f"/api/collaborative/{pid}/versions", data=json.dumps({"version_name":"v2","content_json":{"n":2},"trigger_type":"manual"}), content_type="application/json")
    rb = app.post(f"/api/collaborative/{pid}/rollback", data=json.dumps({"version_id":v1}), content_type="application/json")
    assert rb.status_code == 200
    st = app.get(f"/api/collaborative/{pid}/state").get_json()
    assert st["content"]["n"] == 1

def test_e2e_history_management(app, monkeypatch):
    _auth(app, monkeypatch)
    pid = _new_project(app)
    r = app.post(f"/api/collaborative/{pid}/save-article", data=json.dumps({"title":"hm","topic_json":{},"outline_json":{},"content_json":{"sections":[{"id":"s1","title":"x","content":"正文","status":"generated"}]}}), content_type="application/json")
    aid = r.get_json()["article_id"]
    assert app.get(f"/api/collaborative/articles/{aid}").status_code == 200
    assert app.delete(f"/api/collaborative/articles/{aid}").status_code == 200
    assert app.get(f"/api/collaborative/articles/{aid}").status_code == 404

def test_e2e_platform_removed(app, monkeypatch):
    # 平台路由应不再可访问（404）
    _auth(app, monkeypatch)
    assert app.get("/cover_maker.html").status_code == 404
```

> 注：需在蓝图追加 `POST /api/<id>/versions`（创建快照）与历史文章 API（见 Task 13）。


在 `web_app.py` 中 `app` 定义之后、路由注册区，创建两个蓝图：

```python
from flask import Blueprint
collaborative_bp = Blueprint("collaborative", __name__)
collaborative_api_bp = Blueprint("collaborative_api", __name__)
```

在文件末尾 `app.run(...)` 之前，先实现页面蓝图路由，再实现 API 蓝图路由，最后注册：

```python
# ════════════════════════════════════════════════════════════
# 协同创作：页面蓝图（/collaborative）
# ════════════════════════════════════════════════════════════

@collaborative_bp.route("/", methods=["GET"])
def collab_list():
    user = get_current_user(_get_session_id())
    if not user:
        return redirect("/login.html")
    return send_from_directory(str(BASE_DIR / "templates"), "collaborative/list.html")


@collaborative_bp.route("/create", methods=["POST"])
def collab_create():
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    data = request.get_json(silent=True) or {}
    title = (data.get("title") or "").strip() or "未命名创作"
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute("INSERT INTO collaborative_projects (user_id, title, current_phase) VALUES (?, ?, 'topic')",
                    (user["id"], title))
        db.conn.commit()
        pid = cur.lastrowid
    return jsonify({"project_id": pid})


@collaborative_bp.route("/<int:project_id>", methods=["GET"])
def collab_workbench(project_id: int):
    user = get_current_user(_get_session_id())
    if not user:
        return redirect("/login.html")
    with UserDB() as db:
        proj = db.conn.execute("SELECT * FROM collaborative_projects WHERE id = ? AND user_id = ?",
                               (project_id, user["id"])).fetchone()
    if not proj:
        return redirect("/collaborative")
    return send_from_directory(str(BASE_DIR / "templates"), "collaborative/workbench.html")
```

再实现 API 蓝图（`/api/collaborative`），严格对齐设计文档 §4.1：

```python
# ════════════════════════════════════════════════════════════
# 协同创作：API 蓝图（/api/collaborative）
# ════════════════════════════════════════════════════════════

def _load_project(project_id: int, user_id: int) -> Optional[dict]:
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute("SELECT * FROM collaborative_projects WHERE id = ? AND user_id = ?", (project_id, user_id))
        row = cur.fetchone()
        return dict(row) if row else None


def _json_or_none(s):
    try:
        return json.loads(s) if s else None
    except Exception:
        return None


@collaborative_api_bp.route("/projects", methods=["GET"])
def collab_api_list_projects():
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute("SELECT * FROM collaborative_projects WHERE user_id = ? ORDER BY updated_at DESC, id DESC",
                    (user["id"],))
        projects = [dict(r) for r in cur.fetchall()]
    return jsonify({"projects": projects})


@collaborative_api_bp.route("/projects", methods=["POST"])
def collab_api_create_project():
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    data = request.get_json(silent=True) or {}
    title = (data.get("title") or "").strip() or "未命名创作"
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute("INSERT INTO collaborative_projects (user_id, title, current_phase) VALUES (?, ?, 'topic')",
                    (user["id"], title))
        db.conn.commit()
        pid = cur.lastrowid
    return jsonify({"project_id": pid})


@collaborative_api_bp.route("/<int:project_id>", methods=["GET"])
def collab_api_get_project(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    proj = _load_project(project_id, user["id"])
    if not proj:
        return jsonify({"error": "项目不存在"}), 404
    return jsonify({
        "phase": proj["current_phase"],
        "topic": _json_or_none(proj["topic_json"]),
        "outline": _json_or_none(proj["outline_json"]),
        "content": _json_or_none(proj["content_json"]),
    })


@collaborative_api_bp.route("/<int:project_id>/state", methods=["GET"])
def collab_get_state(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    proj = _load_project(project_id, user["id"])
    if not proj:
        return jsonify({"error": "项目不存在"}), 404
    return jsonify({
        "phase": proj["current_phase"],
        "topic": _json_or_none(proj["topic_json"]),
        "outline": _json_or_none(proj["outline_json"]),
        "content": _json_or_none(proj["content_json"]),
    })


@collaborative_api_bp.route("/<int:project_id>/state", methods=["POST"])
def collab_save_state(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    data = request.get_json(silent=True) or {}
    proj = _load_project(project_id, user["id"])
    if not proj:
        return jsonify({"error": "项目不存在"}), 404
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute(
            "UPDATE collaborative_projects SET current_phase=?, topic_json=?, outline_json=?, content_json=?, updated_at=CURRENT_TIMESTAMP WHERE id=?",
            (data.get("phase", proj["current_phase"]),
             json.dumps(data.get("topic"), ensure_ascii=False) if data.get("topic") is not None else proj["topic_json"],
             json.dumps(data.get("outline"), ensure_ascii=False) if data.get("outline") is not None else proj["outline_json"],
             json.dumps(data.get("content"), ensure_ascii=False) if data.get("content") is not None else proj["content_json"],
             project_id),
        )
        db.conn.commit()
    return jsonify({"success": True})


@collaborative_api_bp.route("/<int:project_id>/generate-topics", methods=["POST"])
def collab_generate_topics(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    topics = ai_writer.generate_topics(data.get("idea", ""), count=data.get("count", 5), user_id=user["id"])
    return jsonify({"topics": topics})


@collaborative_api_bp.route("/<int:project_id>/generate-outline", methods=["POST"])
def collab_generate_outline(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    outline = ai_writer.generate_outline(data.get("topic", ""), context=data.get("context"), user_id=user["id"])
    return jsonify({"outline": outline})


@collaborative_api_bp.route("/<int:project_id>/generate-content", methods=["POST"])
def collab_generate_content(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    result = ai_writer.generate_content(data.get("outline", {}), section=data.get("section_id"), user_id=user["id"])
    return jsonify(result)


def _save_project_json(project_id, field, value):
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute(f"UPDATE collaborative_projects SET {field}=?, updated_at=CURRENT_TIMESTAMP WHERE id=?",
                    (json.dumps(value, ensure_ascii=False), project_id))
        db.conn.commit()


@collaborative_api_bp.route("/<int:project_id>/topic", methods=["PUT"])
def collab_save_topic(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    _save_project_json(project_id, "topic_json", data.get("topic"))
    return jsonify({"success": True})


@collaborative_api_bp.route("/<int:project_id>/outline", methods=["PUT"])
def collab_save_outline(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    _save_project_json(project_id, "outline_json", data.get("outline"))
    return jsonify({"success": True})


@collaborative_api_bp.route("/<int:project_id>/content", methods=["PUT"])
def collab_save_content(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    _save_project_json(project_id, "content_json", data.get("content"))
    return jsonify({"success": True})


@collaborative_api_bp.route("/<int:project_id>/save-article", methods=["POST"])
def collab_save_article(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    proj = _load_project(project_id, user["id"])
    if not proj:
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    try:
        aid = article_history.save_article(
            user_id=user["id"],
            title=data.get("title") or proj["title"] or "未命名文章",
            topic_json=_json_or_none(proj["topic_json"]) or {},
            outline_json=_json_or_none(proj["outline_json"]) or {},
            content_json=_json_or_none(proj["content_json"]) or {},
        )
    except ValueError as e:
        return jsonify({"error": str(e)}), 400
    with UserDB() as db:
        db.conn.execute("UPDATE collaborative_projects SET current_phase='save', updated_at=CURRENT_TIMESTAMP WHERE id=?", (project_id,))
        db.conn.commit()
    return jsonify({"article_id": aid})


@collaborative_api_bp.route("/<int:project_id>/versions", methods=["GET"])
def collab_list_versions(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    if not _load_project(project_id, user["id"]):
        return jsonify({"error": "项目不存在"}), 404
    return jsonify({"versions": version_manager.list_versions(project_id)})


@collaborative_api_bp.route("/<int:project_id>/versions", methods=["POST"])
def collab_create_version(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    proj = _load_project(project_id, user["id"])
    if not proj:
        return jsonify({"error": "项目不存在"}), 404
    data = request.get_json(silent=True) or {}
    content = data.get("content_json") or {
        "topic": _json_or_none(proj["topic_json"]),
        "outline": _json_or_none(proj["outline_json"]),
        "content": _json_or_none(proj["content_json"]),
    }
    vid = version_manager.create_snapshot(
        project_id=project_id, user_id=user["id"],
        version_name=data.get("version_name", "手动快照"),
        content_json=content, trigger_type=data.get("trigger_type", "manual"))
    return jsonify({"version_id": vid})


@collaborative_api_bp.route("/<int:project_id>/versions/<int:v_id>", methods=["GET"])
def collab_get_version(project_id, v_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    v = version_manager.get_version(v_id)
    if not v or v["project_id"] != project_id:
        return jsonify({"error": "版本不存在"}), 404
    return jsonify({"content_json": json.loads(v["content_json"])})


@collaborative_api_bp.route("/<int:project_id>/versions/compare", methods=["POST"])
def collab_compare_versions(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    data = request.get_json(silent=True) or {}
    diff = version_manager.compare_versions(data["v1"], data["v2"])
    return jsonify({"diff": diff})


@collaborative_api_bp.route("/<int:project_id>/rollback", methods=["POST"])
def collab_rollback(project_id):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    data = request.get_json(silent=True) or {}
    new_id = version_manager.rollback_to_version(data["version_id"], user["id"])
    return jsonify({"version_id": new_id})


@collaborative_api_bp.route("/articles", methods=["GET"])
def collab_list_articles():
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    return jsonify({"articles": article_history.list_articles(user["id"])})


@collaborative_api_bp.route("/articles/<int:aid>", methods=["GET"])
def collab_get_article(aid):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    art = article_history.get_article(aid, user["id"])
    if not art:
        return jsonify({"error": "文章不存在"}), 404
    return jsonify(art)


@collaborative_api_bp.route("/articles/<int:aid>", methods=["DELETE"])
def collab_delete_article(aid):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    ok = article_history.delete_article(aid, user["id"])
    return jsonify({"success": ok})


@collaborative_api_bp.route("/articles/<int:aid>/continue", methods=["POST"])
def collab_continue_article(aid):
    user = get_current_user(_get_session_id())
    if not user:
        return jsonify({"error": "未登录"}), 401
    art = article_history.get_article(aid, user["id"])
    if not art:
        return jsonify({"error": "文章不存在"}), 404
    with UserDB() as db:
        cur = db.conn.cursor()
        cur.execute(
            "INSERT INTO collaborative_projects (user_id, title, current_phase, topic_json, outline_json, content_json) VALUES (?, ?, 'content', ?, ?, ?)",
            (user["id"], art["title"] + "（续）", art["topic_json"], art["outline_json"], art["content_json"]))
        db.conn.commit()
        pid = cur.lastrowid
    return jsonify({"project_id": pid})


app.register_blueprint(collaborative_bp, url_prefix="/collaborative")
app.register_blueprint(collaborative_api_bp, url_prefix="/api/collaborative")
```


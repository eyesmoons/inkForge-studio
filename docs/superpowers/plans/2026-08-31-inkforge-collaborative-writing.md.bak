- [ ] **Step 3: 在 `ai_writer.py` 追加三个函数**

在 `generate_article` 之后追加。三个函数统一：检测后端 → 构造 prompt → 调用 LLM → `json.loads` 解析并做结构校验/补全；`backend == "template"` 时走内置模板 fallback。

```python
def generate_topics(idea: str, count: int = 5, user_id: int = None) -> List[Dict]:
    """根据想法生成多个选题建议。返回 [{title, description}, ...]（3-5 个）。"""
    backend, cfg = _detect_llm_backend(user_id)
    prompt = (
        f"你是一位资深内容策划。创作者的想法是：「{idea}」。\n"
        f"请生成 {count} 个不同角度的选题，每个选题包含「标题」和「一句话说明」。\n"
        "仅返回 JSON 数组，例如 [{\"title\": \"...\", \"description\": \"...\"}]，不要任何解释。"
    )
    if backend == "template":
        return _fallback_topics(idea, count)
    try:
        raw = _call_openai(prompt, cfg) if backend == "openai" else _call_ollama(prompt, cfg)
        data = json.loads(raw)
        if not isinstance(data, list):
            raise ValueError("not a list")
        return [{"title": str(t.get("title", "")), "description": str(t.get("description", ""))} for t in data if t.get("title")][:count]
    except Exception as e:
        print(f"   ⚠️ 选题生成失败（{e}），使用内置模板")
        return _fallback_topics(idea, count)


def _fallback_topics(idea: str, count: int) -> List[Dict]:
    seeds = [
        {"title": f"深度解读：{idea}", "description": f"从行业格局深度剖析「{idea}」的来龙去脉。"},
        {"title": f"实用指南：{idea} 怎么用", "description": f"面向普通读者，讲清「{idea}」的实际用法与影响。"},
        {"title": f"观点评论：{idea} 意味着什么", "description": f"给出鲜明观点，评价「{idea}」的利与弊。"},
        {"title": f"趋势前瞻：{idea} 的下一步", "description": f"基于现状推断「{idea}」未来 1-2 年的走向。"},
        {"title": f"案例拆解：{idea} 落地实例", "description": f"用真实案例说明「{idea}」如何落地。"},
    ]
    return seeds[:count]


def generate_outline(topic: str, context: str = None, user_id: int = None) -> Dict:
    """基于选题生成结构化大纲。返回 {sections:[{id, title, points, children}]}。"""
    backend, cfg = _detect_llm_backend(user_id)
    prompt = (
        f"你是一位资深内容策划。选题是：「{topic}」。"
        + (f"补充背景：{context}\n" if context else "")
        + "请生成结构化大纲，包含 3-6 个章节，每个章节有标题、若干要点（points），"
        "可选子章节（children，结构同章节）。\n"
        "仅返回 JSON，例如 {\"sections\": [{\"id\": \"s1\", \"title\": \"...\", \"points\": [\"...\"], \"children\": []}]}，不要任何解释。"
    )
    if backend == "template":
        return _fallback_outline(topic)
    try:
        raw = _call_openai(prompt, cfg) if backend == "openai" else _call_ollama(prompt, cfg)
        data = json.loads(raw)
        data.setdefault("sections", [])
        for i, s in enumerate(data["sections"], 1):
            s.setdefault("id", f"s{i}")
            s.setdefault("points", [])
            s.setdefault("children", [])
        return data
    except Exception as e:
        print(f"   ⚠️ 大纲生成失败（{e}），使用内置模板")
        return _fallback_outline(topic)


def _fallback_outline(topic: str) -> Dict:
    return {"sections": [
        {"id": "s1", "title": f"为什么「{topic}」值得关注", "points": ["背景与现状", "核心矛盾"], "children": []},
        {"id": "s2", "title": f"「{topic}」的核心逻辑", "points": ["关键机制", "影响链条"], "children": []},
        {"id": "s3", "title": "对我们的实际影响", "points": ["短期影响", "长期趋势"], "children": []},
        {"id": "s4", "title": "结语", "points": ["总结与展望"], "children": []},
    ]}


def generate_content(outline: Dict, section: str = None, user_id: int = None) -> Dict:
    """基于大纲生成内容。section 为 None 生成全部，否则仅生成该 id 段落。返回 {sections:[{id, title, content, status}]}。"""
    backend, cfg = _detect_llm_backend(user_id)
    target_sections = [s for s in outline.get("sections", []) if section is None or s.get("id") == section]
    if not target_sections:
        return {"sections": []}
    prompt = (
        "你是一位资深中文作者。请根据以下大纲章节生成正文段落。\n"
        "要求：自然流畅的中文，避免 AI 套话，像真人写作；不要项目符号列表和表格。\n"
        f"大纲 JSON：{json.dumps(target_sections, ensure_ascii=False)}\n"
        "仅返回 JSON，例如 {\"sections\": [{\"id\": \"s1\", \"title\": \"...\", \"content\": \"...\", \"status\": \"generated\"}]}，不要任何解释。"
    )
    if backend == "template":
        return _fallback_content(target_sections)
    try:
        raw = _call_openai(prompt, cfg) if backend == "openai" else _call_ollama(prompt, cfg)
        data = json.loads(raw)
        data.setdefault("sections", [])
        for s in data["sections"]:
            s.setdefault("status", "generated")
        return data
    except Exception as e:
        print(f"   ⚠️ 内容生成失败（{e}），使用内置模板")
        return _fallback_content(target_sections)


def _fallback_content(sections: List[Dict]) -> Dict:
    out = []
    for s in sections:
        title = s.get("title", "")
        points = s.get("points", [])
        body = "。".join(points) if points else f"本节围绕「{title}」展开。"
        out.append({"id": s.get("id"), "title": title, "content": f"{body}。", "status": "generated"})
    return {"sections": out}
```

> 注：需在 `ai_writer.py` 顶部已有 `import json`（已存在）和 `from typing import List, Dict`（按需补）。


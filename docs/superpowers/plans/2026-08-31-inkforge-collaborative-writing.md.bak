### Task 3: 新增 version_manager 模块

**Files:**
- Create: `modules/version_manager.py`
- Test: `tests/test_version_manager.py`

**Interfaces:**
- Consumes: `modules/user_db.get_db`、`UserDB` 连接、`version_snapshots` 表
- Produces: `create_snapshot(project_id, user_id, version_name, content_json, trigger_type) -> int`；`list_versions(project_id) -> list[dict]`；`get_version(version_id) -> dict`；`compare_versions(v1_id, v2_id) -> dict`；`rollback_to_version(version_id, user_id) -> int`

- [ ] **Step 1: 编写 version_manager 失败的回归测试**

```python
import pytest, json
from modules import version_manager

def _project(db, user_id=1):
    cur = db.conn.cursor()
    cur.execute("INSERT INTO collaborative_projects (user_id, current_phase) VALUES (?, 'topic')", (user_id,))
    db.conn.commit()
    return cur.lastrowid

def test_create_snapshot(db):
    pid = _project(db)
    vid = version_manager.create_snapshot(pid, 1, "选题确认", {"topic": "t"}, "manual")
    assert isinstance(vid, int) and vid > 0

def test_list_versions_order(db):
    pid = _project(db)
    version_manager.create_snapshot(pid, 1, "a", {"n": 1}, "auto_topic")
    version_manager.create_snapshot(pid, 1, "b", {"n": 2}, "auto_outline")
    vs = version_manager.list_versions(pid)
    assert len(vs) == 2
    # 按时间倒序
    assert vs[0]["created_at"] >= vs[1]["created_at"]

def test_get_version(db):
    pid = _project(db)
    vid = version_manager.create_snapshot(pid, 1, "x", {"k": "v"}, "manual")
    v = version_manager.get_version(vid)
    assert v["version_name"] == "x"
    assert json.loads(v["content_json"]) == {"k": "v"}

def test_compare_versions(db):
    pid = _project(db)
    v1 = version_manager.create_snapshot(pid, 1, "v1", {"sections": [{"id": "1", "content": "A"}]}, "auto_content")
    v2 = version_manager.create_snapshot(pid, 1, "v2", {"sections": [{"id": "1", "content": "B"}]}, "auto_content")
    diff = version_manager.compare_versions(v1, v2)
    assert "sections" in diff
    changes = diff["sections"]
    assert any(c.get("id") == "1" and c.get("old") == "A" and c.get("new") == "B" for c in changes)

def test_rollback_creates_new_snapshot(db):
    pid = _project(db)
    v1 = version_manager.create_snapshot(pid, 1, "v1", {"n": 1}, "auto_topic")
    new_id = version_manager.rollback_to_version(v1, 1)
    assert new_id != v1
    new = version_manager.get_version(new_id)
    assert json.loads(new["content_json"]) == {"n": 1}
    assert new["trigger_type"] == "manual"

def test_auto_snapshot_cap_at_20(db):
    pid = _project(db)
    for i in range(25):
        version_manager.create_snapshot(pid, 1, f"s{i}", {"n": i}, "auto_content")
    vs = version_manager.list_versions(pid)
    auto = [v for v in vs if v["trigger_type"].startswith("auto")]
    assert len(auto) == 20
    # 保留最新的 20 个
    nums = [json.loads(v["content_json"])["n"] for v in auto]
    assert min(nums) == 5 and max(nums) == 24
```

- [ ] **Step 2: 运行测试确认失败**

Run: `cd /Users/casey/workspace/inkForge-studio && python -m pytest tests/test_version_manager.py -v`
Expected: FAIL（模块不存在）

- [ ] **Step 3: 实现 `modules/version_manager.py`**

```python
import json
from datetime import datetime
from typing import Dict, List, Optional
from modules.user_db import get_db


def create_snapshot(project_id: int, user_id: int, version_name: str,
                    content_json: dict, trigger_type: str) -> int:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            """INSERT INTO version_snapshots
               (project_id, user_id, version_name, content_json, trigger_type)
               VALUES (?, ?, ?, ?, ?)""",
            (project_id, user_id, version_name, json.dumps(content_json, ensure_ascii=False), trigger_type),
        )
        db.conn.commit()
        sid = cur.lastrowid
    # 仅对自动快照做 20 个上限裁剪
    if trigger_type.startswith("auto"):
        _cap_auto_snapshots(project_id)
    return sid


def _cap_auto_snapshots(project_id: int, cap: int = 20):
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            """DELETE FROM version_snapshots WHERE id NOT IN (
                 SELECT id FROM version_snapshots
                 WHERE project_id = ? AND trigger_type LIKE 'auto%'
                 ORDER BY created_at DESC, id DESC LIMIT ?
               ) AND project_id = ? AND trigger_type LIKE 'auto%'""",
            (cap, project_id, project_id),
        )
        db.conn.commit()


def list_versions(project_id: int) -> List[Dict]:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            """SELECT id, project_id, user_id, version_name, content_json, trigger_type, created_at
               FROM version_snapshots WHERE project_id = ?
               ORDER BY created_at DESC, id DESC""",
            (project_id,),
        )
        return [dict(r) for r in cur.fetchall()]


def get_version(version_id: int) -> Optional[Dict]:
    with get_db() as db:
        cur = db.conn.cursor()
        cur.execute(
            """SELECT id, project_id, user_id, version_name, content_json, trigger_type, created_at
               FROM version_snapshots WHERE id = ?""",
            (version_id,),
        )
        row = cur.fetchone()
        return dict(row) if row else None


def compare_versions(v1_id: int, v2_id: int) -> Dict:
    a = get_version(v1_id)
    b = get_version(v2_id)
    if not a or not b:
        raise ValueError("版本不存在")
    c1 = json.loads(a["content_json"])
    c2 = json.loads(b["content_json"])
    return _diff_content(c1, c2)


def _diff_content(c1: dict, c2: dict) -> dict:
    """对 content_json 做浅层 diff：以 sections 数组按 id 匹配，列出字段变更。"""
    diff = {}
    if "sections" in c1 or "sections" in c2:
        s1 = {s.get("id"): s for s in (c1.get("sections") or [])}
        s2 = {s.get("id"): s for s in (c2.get("sections") or [])}
        changes = []
        for sid in set(s1) | set(s2):
            if s1.get(sid) != s2.get(sid):
                changes.append({"id": sid, "old": s1.get(sid), "new": s2.get(sid)})
        diff["sections"] = changes
    for key in set(c1) | set(c2):
        if key == "sections":
            continue
        if c1.get(key) != c2.get(key):
            diff[key] = {"old": c1.get(key), "new": c2.get(key)}
    return diff


def rollback_to_version(version_id: int, user_id: int) -> int:
    v = get_version(version_id)
    if not v:
        raise ValueError("版本不存在")
    return create_snapshot(
        project_id=v["project_id"],
        user_id=user_id,
        version_name=f"回溯自 {v['version_name'] or version_id}",
        content_json=json.loads(v["content_json"]),
        trigger_type="manual",
    )
```

